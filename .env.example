# Copy to .env and fill in. .env is git-ignored and never copied into the Docker image.

# Fine-grained GitHub token with read-only access to public repositories.
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx

# OpenRouter API key (used from Plan 3 onwards).
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx

# Optional
# LOG_LEVEL=INFO
# ADVISORY_CACHE_TTL_HOURS=24
